# Copy to .env and adjust. Used by both docker-compose.yml (dev) and
# docker-compose.prod.yml — required values differ per file (see comments
# in each; dev has safe defaults baked in, prod fails fast if unset).

DB_NAME=pokergto
DB_USERNAME=pokergto
DB_PASSWORD=pokergto

# Keycloak realm/client the backend uses to create users (Admin API) and
# obtain tokens (password + refresh grants) on their behalf. Dev falls back
# to the values baked into keycloak/realm-export.json.
KEYCLOAK_REALM=pokergto
KEYCLOAK_CLIENT_ID=pokergto-backend
KEYCLOAK_CLIENT_SECRET=change-me-to-a-long-random-value

CORS_ALLOWED_ORIGINS=http://localhost:4200
